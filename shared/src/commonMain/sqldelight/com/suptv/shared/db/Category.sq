CREATE TABLE Category (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    providerId INTEGER NOT NULL,
    name TEXT NOT NULL,
    sortOrder INTEGER DEFAULT 0,
    FOREIGN KEY (providerId) REFERENCES Provider(id) ON DELETE CASCADE
);

CREATE INDEX category_provider_idx ON Category(providerId);

selectAll:
SELECT * FROM Category;

selectById:
SELECT * FROM Category WHERE id = ?;

selectByProvider:
SELECT * FROM Category WHERE providerId = ? ORDER BY sortOrder, name;

insert:
INSERT INTO Category(providerId, name, sortOrder)
VALUES (?, ?, ?);

update:
UPDATE Category SET name = ?, sortOrder = ? WHERE id = ?;

delete:
DELETE FROM Category WHERE id = ?;

deleteByProvider:
DELETE FROM Category WHERE providerId = ?;

lastInsertRowId:
SELECT last_insert_rowid();
